// PYAAS consumer app — build configuration.
//
// This is the ONE place to point the app at a backend. The values flow into
// Info.plist (SUPABASE_HOST / SUPABASE_ANON_KEY) and are read at runtime by
// AppConfig. Only client-safe values belong here — the Supabase anon key is
// public by design and gated server-side by Row-Level Security. NEVER put a
// service_role key, DB password, or any gateway secret in this file.
//
// NOTE: xcconfig treats "//" as a comment, so the host is stored WITHOUT the
// scheme; AppConfig prepends "https://". Do not add "https://" here.

SUPABASE_HOST = mpzvykwayknrohzihakq.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1wenZ5a3dheWtucm9oemloYWtxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA4MDIwMjgsImV4cCI6MjA5NjM3ODAyOH0.Up4VC5E1oSuGLIE3jdFTnHgXW5O4c9eJn_apze9DzUU

// Admin allowlist — comma-separated emails that unlock the in-app Admin panel
// after sign-in. This is a UI gate only; the DB must ALSO grant these emails an
// admin RLS policy server-side to actually read cross-tenant data (see
// docs/HANDOFF.md). Replace with the two real owner emails.
ADMIN_EMAILS = hello@pyaasdairy.com,admin@pyaasdairy.com
