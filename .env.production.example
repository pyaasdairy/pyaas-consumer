# ─────────────────────────────────────────────────────────────────────────────
# PYAAS consumer — PRODUCTION build env (for the Play Store AAB)
#
# HOW THIS IS USED: every EXPO_PUBLIC_* value is INLINED into the JS bundle at
# build time. For a LOCAL gradle build the values are read from `.env`, so to
# build the store AAB you copy this file to `.env` (with the real values filled
# in), build, then restore your local `.env`. Nothing here may point at
# localhost or carry a test flag.
#
# Lines marked  << YOU  need a value only you have.
# Lines marked  << FIXED are the production-correct value (already set for you).
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED — the app is dead without these ────────────────────────────────
# The DEPLOYED backend, https, INCLUDING the mount path. The app appends routes
# directly (`${API_URL}/auth/otp/request`), so a bare host 404s everything.
EXPO_PUBLIC_API_URL=https://REPLACE-WITH-YOUR-HOST/api/v1/consumer            # << YOU
# Must equal the backend's CONSUMER_APP_KEY. Backend fails CLOSED: mismatch → every read 403s.
EXPO_PUBLIC_CONSUMER_APP_KEY=REPLACE-WITH-PROD-CONSUMER-APP-KEY                # << YOU

# ── REQUIRED for payments ───────────────────────────────────────────────────
# A NEW, rotated live key. The old rzp_live_T0Lw… is burned (committed to git);
# rotate at Razorpay first. Empty → checkout refuses to open (no fallback key).
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_ROTATED_KEY                  # << YOU

# ── OPTIONAL — sensible behaviour if omitted ────────────────────────────────
# Address autocomplete. Absent → typed search hidden; city-picker + map-pin still work.
# What the user types goes to Google (disclosed in-app; declare "shared" on Data Safety).
EXPO_PUBLIC_GOOGLE_PLACES_KEY=                                                 # << YOU (optional)
# Support WhatsApp, full international digits (e.g. 919667260050). Absent → row hides.
EXPO_PUBLIC_CARE_WHATSAPP=                                                     # << YOU (optional)
# Care phone override. Defaults to 9667260050 (lib/support.ts) if unset — leave blank to use that.
EXPO_PUBLIC_CARE_PHONE=

# ── LAUNCH ZONE — defaults to Sushant Golf City, Lucknow ────────────────────
# Override only to move/resize the serviceable area. Blank = the built-in default.
EXPO_PUBLIC_SERVICE_AREA_LAT=
EXPO_PUBLIC_SERVICE_AREA_LNG=
EXPO_PUBLIC_SERVICE_RADIUS_KM=
EXPO_PUBLIC_SERVICE_AREA_LABEL=

# ── FIXED — production-correct, do not change ───────────────────────────────
EXPO_PUBLIC_WALLET_TEST_TOPUP=false                                           # << FIXED (test top-up + dev OTP OFF)
EXPO_PUBLIC_CATALOG_BACKEND_AUTHORITATIVE=true                                # << FIXED (products render server-side)
EXPO_PUBLIC_PREPAID_TARGET=500                                                # << FIXED (default recharge suggestion)
# MSG91 keys MUST NOT be set for a store build — an EXPO_PUBLIC_ SMS authkey
# ships inside the APK and is extractable. OTP goes through the backend only.
# (Leave both unset / absent.)
# EXPO_PUBLIC_MSG91_AUTHKEY=
# EXPO_PUBLIC_MSG91_TEMPLATE_ID=
