# ============================================================================
# PYAAS app env TEMPLATE. Copy to .env and fill in:   cp .env.example .env
# ONLY EXPO_PUBLIC_* belongs here (these ship in the app bundle, nothing
# secret). Server secrets live with the API (apps/parag-api/.env).
# After editing .env, restart with: npx expo start -c
# ============================================================================

# ── PARAG API (NestJS, apps/parag-api) ──────────────────────────────────────
# Local dev: your machine's LAN IP so a device/simulator can reach it,
# e.g. http://192.168.1.10:4000 (plain http is fine in dev).
# Leave empty to run the app fully offline on the bundled catalog
# (auth, orders, wallet and subscriptions need the API).
EXPO_PUBLIC_API_URL=

# ── Razorpay (wallet top-up / recharge) ─────────────────────────────────────
# PUBLIC key_id only (safe to ship). The key_SECRET must live server-side in
# apps/parag-api, which creates the order and verifies the payment signature
# before crediting the wallet (see lib/razorpay.ts + RAZORPAY_WALLET_BACKEND.md).
# LIVE key = real charges: use a rzp_test_ key here for development.
#
# The recharge screen (app/recharge.tsx) opens the best available Razorpay sheet:
#   1. NATIVE multi-method sheet — UPI-intent (GPay/PhonePe/Paytm/CRED), cards,
#      netbanking, wallets, QR. Requires BOTH:  (a) `npm i react-native-razorpay`
#      + a DEV BUILD (`npx expo run:android`, NOT Expo Go), and (b) a real
#      EXPO_PUBLIC_RAZORPAY_KEY_ID below.
#   2. WebView sheet (fallback) — real Razorpay checkout, no native module needed.
#   3. Dev mock success — when WALLET_TEST_TOPUP=true (credits directly, no gateway).
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_T0LwnoiGRHGIGG

# App-key that gates the traceability bridge to the PARAG app (ships in the bundle)
EXPO_PUBLIC_CONSUMER_APP_KEY=parag_consumer_dev_key_v1

# ── Phase-2 backend-authoritative catalog (docs/phase2-catalog-migration.md) ──
# OFF (default): the bundled constants/products.ts is the source of truth; the
# backend catalog overlay only adjusts price / stock / tag (today's behaviour).
# ON ("true"): a backend row matching a bundled SKU id overrides its full
# identity too (name / images / compliance / rating), and product images load
# from the backend (B2 via /consumer/catalog/img/...). The bundle stays the
# offline fallback. Turn ON only against a backend running with
# CONSUMER_CATALOG_SEED_SERVE=true (so the 48 seeded products are served).
EXPO_PUBLIC_CATALOG_BACKEND_AUTHORITATIVE=false

# TEST-ONLY: credit the wallet directly on "Add money" (no Razorpay). Backend must
# run OTP_DEV_MODE. Flip off + set real Razorpay keys for production.
EXPO_PUBLIC_WALLET_TEST_TOPUP=true

# ── MSG91 OTP (real SMS one-time codes, lib/msg91.ts) ───────────────────────
# Set BOTH to send/verify login OTPs through MSG91 directly from the app.
# Priority: parag-api backend (EXPO_PUBLIC_API_URL) > MSG91 > offline dev code.
# AUTHKEY: MSG91 dashboard > Authkey. TEMPLATE_ID: an APPROVED DLT OTP template.
# For Android SMS auto-read the template text must start with "<#>" and end
# with the app-signature hash (Diagnostics screen / lib/nativeConvenience).
EXPO_PUBLIC_MSG91_AUTHKEY=
EXPO_PUBLIC_MSG91_TEMPLATE_ID=

# ── Customer care (single source: lib/support.ts) ───────────────────────────
# Display-format toll-free line shown across the app, invoices and statements.
# PLACEHOLDER default in code ("1800 120 7929") — founder to supply the real
# PYAAS toll-free number here. The digits-only tel: variant is derived in code.
EXPO_PUBLIC_CARE_PHONE=
# WhatsApp Business number for the wa.me support link — FULL INTERNATIONAL
# digits (country code + number, no '+'), e.g. 919123456780. Kept separate from
# the toll-free line: wa.me cannot parse domestic/toll-free digits.
# PLACEHOLDER default in code — founder to supply the real number here.
EXPO_PUBLIC_CARE_WHATSAPP=

# ── Native "hyper-convenience" onboarding (docs/native-convenience.md) ───────
# Google Places Autocomplete for the address screen. Leave EMPTY → the screen
# falls back to plain manual typing (no network, no dropdown). When set, lib/
# places.ts suggests addresses as the user types. PUBLIC key (ships in bundle):
# restrict it in Google Cloud Console to the Places API + this app's package id.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
# Set to 1 ONLY in a dev/prod build that has added the native phone-hint /
# SMS-retriever modules — this makes plugins/withNativeConvenience.js inject the
# READ_PHONE_NUMBERS / RECEIVE_SMS Android permissions at prebuild. Leave empty
# for the JS-only build (no extra permissions; features degrade to OS autofill).
EXPO_PUBLIC_NATIVE_CONVENIENCE=
