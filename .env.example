# ============================================================================
# PYAAS app env TEMPLATE — copy to .env and fill in.   cp .env.example .env
# ONLY EXPO_PUBLIC_* belongs here (these ship in the app bundle — nothing
# secret). Server secrets go in supabase/functions.env.example instead.
# After editing .env, restart with: npx expo start -c
# ============================================================================

# ── Supabase (REQUIRED) ── dashboard → Project Settings → API ───────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...

# ── Razorpay (payments) — PUBLISHABLE key id only ───────────────────────────
# Razorpay → Settings → API Keys (the secret stays server-side, not here)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# ── OTP/SMS (MSG91) — no client key (sent via Supabase SMS Hook, server-side)
# ── Push (optional) — Expo project id is in app.json; APNs key is in EAS
