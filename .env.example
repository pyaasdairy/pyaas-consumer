# ============================================================================
# PARAG app env TEMPLATE. Copy to .env and fill in:   cp .env.example .env
# ONLY EXPO_PUBLIC_* belongs here (these ship in the app bundle, nothing
# secret). Server secrets live with the API (apps/parag-api/.env).
# After editing .env, restart with: npx expo start -c
# ============================================================================

# ── PARAG API (NestJS, apps/parag-api) ──────────────────────────────────────
# Local dev: your machine's LAN IP so a device/simulator can reach it,
# e.g. http://192.168.1.10:4000 (plain http is fine in dev).
# Leave empty to run the app fully offline on the bundled catalog
# (auth, orders, wallet and subscriptions need the API).
EXPO_PUBLIC_API_URL=

# ── Razorpay (wallet top-up) ────────────────────────────────────────────────
# PUBLIC key_id only (safe to ship). The key_SECRET must live server-side in
# apps/parag-api, which creates the order and verifies the payment signature
# before crediting the wallet (see lib/razorpay.ts + RAZORPAY_WALLET_BACKEND.md).
# LIVE key = real charges: use a rzp_test_ key here for development.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_T0LwnoiGRHGIGG

# App-key that gates the traceability bridge to the PARAG app (ships in the bundle)
EXPO_PUBLIC_CONSUMER_APP_KEY=parag_consumer_dev_key_v1

# TEST-ONLY: credit the wallet directly on "Add money" (no Razorpay). Backend must
# run OTP_DEV_MODE. Flip off + set real Razorpay keys for production.
EXPO_PUBLIC_WALLET_TEST_TOPUP=true
