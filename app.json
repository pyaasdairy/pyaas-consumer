{
  "expo": {
    "name": "PYAAS",
    "slug": "pyaas-app",
    "version": "1.0.0",
    "scheme": [
      "pyaas",
      "parag"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.pyaasdairy.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PYAAS uses your location to set your delivery address and show your rider on the way.",
        "NSPhotoLibraryUsageDescription": "PYAAS uses your photos so you can set a profile picture.",
        "NSCameraUsageDescription": "PYAAS uses the camera to scan the QR on your pack and show you which dairy and quality tests it came from.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.pyaasdairy.app",
      "versionCode": 28,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F36DB6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PYAAS uses your photos so you can set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PYAAS uses the camera to scan the QR on your pack and show you which dairy and quality tests it came from.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PYAAS uses your location to set your delivery address and show your rider on the way.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sharing",
      "./plugins/withNativeConvenience",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark-white.png",
          "resizeMode": "contain",
          "backgroundColor": "#F36DB6"
        }
      ],
      "expo-image"
    ]
  }
}
