# ============================================================================
# SERVER-SIDE secrets for Supabase Edge Functions (OTP SMS, status SMS/push,
# Razorpay webhook). These are NEVER in the app/.env — they would leak in the
# client bundle. Fill in, then load into Supabase:
#
#   cp supabase/functions.env.example supabase/functions.env   # fill values
#   supabase secrets set --env-file supabase/functions.env
#
# (Add supabase/functions.env to .gitignore — never commit real secrets.)
# ============================================================================

# ── Supabase service role (server-only superkey) ────────────────────────────
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ── MSG91 (OTP login + transactional/pickup SMS) ────────────────────────────
# MSG91 dashboard → API. Register Sender ID + DLT templates first.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PYAASD
MSG91_OTP_TEMPLATE_ID=
MSG91_TXN_TEMPLATE_ID=

# ── Razorpay (wallet recharge / prepaid orders) ─────────────────────────────
# Razorpay → Settings → API Keys, and Webhooks → Secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Apple In-App Purchase (VIP membership) ──────────────────────────────────
# App Store Connect → your subscription → App-Specific Shared Secret
APPLE_IAP_SHARED_SECRET=
